        },
        {
            "m_Id": "bd9243806fe54e5fbd0b0365738e91fc"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetRealShadow",
    "m_FunctionSource": "",
    "m_FunctionBody": "#if defined(UNIVERSAL_LIGHTING_INCLUDED)\n    #if SHADOWS_SCREEN\n        float4 clipPos = TransformWorldToHClip(WorldPos);\n        float4 shadowCoord = ComputeScreenPos(clipPos);\n    #else\n        float4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\n    #endif\n\n    Light mainLight = GetMainLight(shadowCoord);\n    Attenuation = mainLight.shadowAttenuation;\n#else\n    Attenuation = 1.0;\n#endif\n"
}

